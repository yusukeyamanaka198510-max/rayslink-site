---
import Base from '../layouts/Base.astro';
import Curve from '../components/Curve.astro';
import { company, history } from '../data/site';
const rows = [
  ['会社名', company.name], ['設立', company.founded], ['代表取締役', company.ceo],
  ['所在地', `${company.zip} ${company.address}`], ['資本金', company.capital],
  ['電話', company.tel], ['法人番号', company.corpNo],
];
---
<Base title="会社概要" path="/about/" description="株式会社Rays linkの会社概要と沿革。2019年1月11日創業、東京都渋谷区代々木に所在。">
  <section class="phero">
    <div class="big-word" aria-hidden="true">2019</div>
    <div class="wrap">
      <p class="eyebrow" data-reveal>会社概要 / ABOUT</p>
      <h1 class="mega" style="margin-top:18px"><span class="line-in"><span>会社概要。</span></span></h1>
    </div>
  </section>
  <section class="bg-beige" style="padding-bottom:clamp(40px,6vw,90px)">
    <div class="wrap">
      <div class="matte panel" data-reveal>
        <dl class="profile">
          {rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>
      </div>
    </div>
  </section>
  <Curve from="beige" to="ivory" variant="4" />
  <section class="bg-ivory" style="padding-bottom:clamp(60px,9vw,120px)">
    <div class="wrap">
      <p class="eyebrow" data-reveal>沿革 / HISTORY</p>
      <h2 class="h-xl" style="margin-top:16px" data-reveal>沿革</h2>
      <div class="vtl">
        <div class="track" aria-hidden="true"><div class="fill"></div></div>
        {history.map((h) => (
          <div class="vitem">
            <div><div class="y">{h.year.split('.')[0]}</div><div class="d">{h.date}</div></div>
            <ul>{h.items.map((t) => <li class="matte">{t}</li>)}</ul>
          </div>
        ))}
      </div>
      <div class="btns" style="margin-top:32px"><a class="btn btn-primary" href="/contact/">お問い合わせ <span aria-hidden="true">→</span></a></div>
    </div>
  </section>
</Base>
