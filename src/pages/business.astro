---
import Base from '../layouts/Base.astro';
import Curve from '../components/Curve.astro';
import BusinessSections from '../components/BusinessSections.astro';
---
<Base title="事業内容" path="/business/" description="株式会社Rays linkの事業紹介。Education・Hospitality・Sustainability・Technologyの4領域と、提携事業(PARTNERSHIP BUSINESS)をご紹介します。">
  <section class="phero">
    <div class="wrap">
      <p class="eyebrow" data-reveal>事業内容 / BUSINESS</p>
      <h1 class="mega" style="margin-top:18px"><span class="line-in"><span>事業内容</span></span></h1>
      <p class="lead" style="margin-top:24px;max-width:32em" data-reveal>教育、宿泊、サステナビリティ、IT・デジタルの4領域で展開する自社事業と、提携先とともに取り組む提携事業をご紹介します。</p>
    </div>
  </section>

  <BusinessSections />
  <Curve from="navy" to="ivory" variant="3" />
</Base>
