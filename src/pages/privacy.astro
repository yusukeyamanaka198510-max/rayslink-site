---
import Base from '../layouts/Base.astro';
import Curve from '../components/Curve.astro';

// 確定原稿（2026年11月10日制定）。文言は原稿のまま掲載する。
type Block = { p: string } | { ol: string[] };
const articles: { n: number; title: string; blocks: Block[] }[] = [
  { n: 1, title: '取得する個人情報', blocks: [
    { p: '当社は、本サイトのお問い合わせフォーム等を通じて、以下の情報を取得することがあります。' },
    { ol: ['氏名', 'メールアドレス', '会社名・団体名', '電話番号', 'お問い合わせの種別および内容', 'その他、お問い合わせに際してご本人が提供する情報'] },
    { p: 'また、本サイトの運営に伴い、IPアドレス、ブラウザ情報、アクセス日時、閲覧履歴等の技術的情報を取得する場合があります。' },
  ] },
  { n: 2, title: '利用目的', blocks: [
    { p: '当社は、取得した個人情報を以下の目的で利用します。' },
    { ol: ['お問い合わせへの回答および必要なご連絡', 'お問い合わせの受付確認メールの送信', '当社の事業・サービスに関するご相談への対応', '業務提携、協業等に関するご相談および連絡調整', 'お問い合わせ履歴の管理および対応品質の改善', '本サイトの安全性の確保、不正アクセスや迷惑行為の防止', 'その他、上記の利用目的に付随する業務'] },
    { p: '上記以外の目的で個人情報を利用する必要が生じた場合には、法令により認められる場合を除き、必要な手続きを行います。' },
  ] },
  { n: 3, title: '個人情報の第三者提供', blocks: [
    { p: '当社は、次の場合を除き、本人の事前の同意なく個人データを第三者に提供しません。' },
    { ol: ['法令に基づく場合', '人の生命、身体または財産の保護のために必要であり、本人の同意を得ることが困難な場合', '公衆衛生の向上または児童の健全な育成の推進のために特に必要であり、本人の同意を得ることが困難な場合', '国の機関または地方公共団体等が法令に定める事務を遂行することに協力する必要があり、本人の同意により当該事務の遂行に支障を及ぼすおそれがある場合', 'その他、個人情報保護法により認められる場合'] },
  ] },
  { n: 4, title: '業務委託', blocks: [
    { p: '当社は、本サイトの運営、サーバー管理、お問い合わせ管理、電子メール送信等の業務を外部事業者に委託する場合があります。' },
    { p: 'この場合、業務遂行に必要な範囲で個人データを取り扱わせるとともに、委託先に対して必要かつ適切な監督を行います。' },
    { p: '外国に所在する事業者による個人データの取扱いについては、適用される法令に従い、必要な確認および措置を講じます。' },
  ] },
  { n: 5, title: '個人情報の安全管理', blocks: [
    { p: '当社は、個人データの漏えい、滅失、毀損、不正アクセス等を防止するため、取扱状況に応じた必要かつ適切な安全管理措置を講じます。' },
    { p: 'また、個人データを取り扱う従業者および委託先に対して、必要かつ適切な監督を行います。' },
    { p: '安全管理措置の具体的な内容については、法令に基づき開示を控えるべき事項を除き、ご本人からのお問い合わせに応じてご案内します。' },
  ] },
  { n: 6, title: '個人情報の保管および削除', blocks: [
    { p: '当社は、個人情報を利用目的の達成に必要な期間、または法令上保存が必要な期間に限り保管します。' },
    { p: '保管の必要がなくなった個人情報については、法令その他の事情を考慮したうえで、適切な方法により削除または廃棄するよう努めます。' },
  ] },
  { n: 7, title: '開示・訂正・利用停止等', blocks: [
    { p: '当社は、ご本人から保有個人データの利用目的の通知、開示、訂正、追加、削除、利用停止、消去または第三者提供の停止等について、法令に基づく請求を受けた場合、本人確認を行ったうえで、法令に従い適切に対応します。' },
    { p: 'これらの請求をご希望の場合は、第9条のお問い合わせ窓口までご連絡ください。' },
    { p: '請求の内容に応じて、本人確認に必要な情報および具体的な手続きをご案内します。法令により請求に応じられない場合には、その旨をご説明します。' },
  ] },
  { n: 8, title: 'Cookie等の利用', blocks: [
    { p: '本サイトでは、利便性の向上、正常な動作の維持、セキュリティの確保等を目的として、Cookieその他これに類する技術を利用する場合があります。' },
    { p: 'また、アクセス解析ツール等を導入する場合には、利用するサービスの内容に応じて、取得する情報、利用目的および第三者への情報送信に関する必要な事項を本サイト上でご案内します。' },
    { p: 'ブラウザの設定によってCookieを制限できる場合がありますが、その場合、本サイトの一部機能が正常に動作しない可能性があります。' },
  ] },
  { n: 9, title: 'お問い合わせ窓口', blocks: [
    { p: '個人情報の取扱いに関するご質問、苦情、開示等の請求については、以下までお問い合わせください。' },
  ] },
  { n: 10, title: 'プライバシーポリシーの変更', blocks: [
    { p: '当社は、法令の改正、事業内容の変更その他必要に応じて、本プライバシーポリシーを見直し、変更することがあります。' },
    { p: '変更後の内容は本サイトに掲載し、法令上必要な場合には、所定の手続きにより通知または同意取得等を行います。' },
  ] },
];
---
<Base title="プライバシーポリシー" path="/privacy/" description="株式会社Rays linkのプライバシーポリシー。個人情報の取得、利用目的、第三者提供、安全管理、開示請求等の取扱いについて定めています。">
  <section class="phero" style="padding-bottom:clamp(28px,4vw,56px)">
    <div class="wrap">
      <p class="eyebrow" data-reveal>PRIVACY POLICY</p>
      <h1 class="mega" style="margin-top:18px;font-size:clamp(2.1rem,6.4vw,5rem)" data-reveal>プライバシーポリシー</h1>
    </div>
  </section>

  <section class="bg-beige" style="padding-bottom:clamp(60px,9vw,120px)">
    <div class="wrap">
      <nav class="policy-toc" aria-label="目次">
        <p class="toc-title">目次</p>
        <ol>
          {articles.map((a) => <li><a href={`#art${a.n}`}>第{a.n}条　{a.title}</a></li>)}
        </ol>
      </nav>

      <article class="matte policy">
        <p>株式会社Rays link（以下「当社」といいます。）は、個人情報の重要性を認識し、個人情報の保護に関する法律その他の関係法令およびガイドラインを遵守するとともに、個人情報を適切に取得、利用、管理するよう努めます。</p>
        <p>本プライバシーポリシーは、当社が運営する公式コーポレートサイト（以下「本サイト」といいます。）における個人情報の取扱いについて定めるものです。</p>

        {articles.map((a) => (
          <section id={`art${a.n}`}>
            <h2>第{a.n}条（{a.title}）</h2>
            {a.blocks.map((b) => 'p' in b ? <p>{b.p}</p> : <ol>{b.ol.map((li) => <li>{li}</li>)}</ol>)}
            {a.n === 9 && (
              <address class="contact-block">
                <p class="who">個人情報取扱事業者</p>
                <p>株式会社Rays link</p>
                <p>代表取締役：山中 雄介</p>
                <p>所在地：〒151-0053<br />東京都渋谷区代々木1丁目10-5<br />代々木伊藤ローヤルコーポ505</p>
                <p>電話番号：<a href="tel:0363009116">03-6300-9116</a></p>
                <p>お問い合わせ：<a href="/contact/">本サイトのお問い合わせフォーム</a></p>
              </address>
            )}
          </section>
        ))}

        <div class="policy-end">
          <p>制定日：2026年11月10日</p>
          <p>株式会社Rays link</p>
          <p>代表取締役 山中 雄介</p>
        </div>
      </article>
    </div>
  </section>
  <Curve from="beige" to="ivory" variant="1" />
</Base>
