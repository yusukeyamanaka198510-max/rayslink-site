---
import Base from '../layouts/Base.astro';
import Curve from '../components/Curve.astro';
import BusinessSections from '../components/BusinessSections.astro';
import { images } from '../data/site';
---
<Base title="TOP" path="/" description="株式会社Rays linkの公式サイト。Live Fully. Laugh Freely. 一笑懸命。若者に選択肢を提供し、希望や可能性を届けます。金融教育・宿泊・IT・デジタルなどを展開。">
  <section class="hero">
    <div class="wrap">
      <p class="kicker" data-reveal><span class="kicker-sub">教育・宿泊・IT・デジタルで希望と可能性を届ける会社</span></p>
      <h1 aria-label="Live Fully. Laugh Freely."><span class="line-in" aria-hidden="true"><span>Live Fully.</span></span><span class="line-in" aria-hidden="true" style="--d:.12s"><span>Laugh Freely.</span></span></h1>
      <div class="jp" data-reveal style="--d:.35s">
        <p class="name">一笑懸命。</p>
        <p style="text-wrap:balance">人生に希望と可能性を。</p>
        <p class="what">金融教育・宿泊・IT・デジタルなどの様々な業種の事業を展開することにより、社会への貢献を果たし、次世代に希望と可能性を届ける。</p>
      </div>
      <div class="btns" data-reveal style="--d:.5s">
        <a class="btn btn-primary" href="#business">事業内容を見る <span aria-hidden="true">→</span></a>
        <a class="btn btn-text" href="/about/">会社概要</a>
      </div>
    </div>
    <div class="hero-bg" aria-hidden="true"><img src={images.hero} alt="" width="1795" height="876" fetchpriority="high" decoding="async" /><span class="hero-mark"></span></div>
  </section>

  <BusinessSections intro />
  <section class="bg-navy cta-sec" style="padding-top:clamp(55px,7vw,89px);padding-bottom:clamp(60px,9vw,120px)">
    <div class="wrap" data-reveal>
      <p class="eyebrow">お問い合わせ / CONTACT</p>
      <h2 class="mega" style="margin-top:18px">お問い合わせ</h2>
      <p class="lead">事業・サービス、提携・協業、取材・メディアなどのご相談は、こちらからお問い合わせください。</p>
      <a class="btn btn-primary" href="/contact/">お問い合わせフォームへ <span aria-hidden="true">→</span></a>
    </div>
  </section>
  <Curve from="navy" to="ivory" variant="2" />
</Base>
