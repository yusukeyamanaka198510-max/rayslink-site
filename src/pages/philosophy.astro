---
import Base from '../layouts/Base.astro';
import Curve from '../components/Curve.astro';
import { images } from '../data/site';
const items = [
  { tag: 'MISSION', t: '若者に選択肢を提供し、希望や可能性を届ける。', r: false },
  { tag: 'VISION', t: '一人ひとりが光を放ち、その光が社会を照らす。', r: true },
  { tag: 'VALUE', t: 'Be Rays — 自ら輝き、周囲を照らす存在であれ。', r: false },
];
const kw = ['一笑懸命', '笑いながら全力疾走', '希望主義', 'Link the Future', '遊び心 × 本気'];
---
<Base title="企業理念" path="/philosophy/" description="株式会社Rays linkの企業理念「一笑懸命。」と、MISSION・VISION・VALUE、大切にする価値観をご紹介します。">
  <section class="phero">
    <div class="wrap" style="display:grid;grid-template-columns:1.2fr 1fr;gap:clamp(24px,4vw,64px);align-items:end">
      <div>
        <p class="eyebrow" data-reveal>企業理念 / PHILOSOPHY</p>
        <h1 class="mega" style="margin-top:18px"><span class="line-in"><span>一笑</span></span><span class="line-in" style="--d:.1s"><span>懸命。</span></span></h1>
        <p class="lead" style="margin-top:26px;max-width:30em" data-reveal>笑いながら、全力で。私たちは「一笑懸命」を企業理念に、若者の未来に光を届けます。</p>
      </div>
      <div class="phero-photo" data-reveal><img src={images.philosophy} alt="" width="1200" height="900" data-speed="-0.04" /></div>
    </div>
  </section>
  <Curve from="beige" to="ivory" variant="3" />

  <section class="section bg-ivory" style="padding-top:clamp(20px,4vw,60px)">
    <div class="wrap mvv">
      {items.map((i) => (
        <div class={`matte vpanel ${i.r ? 'r' : ''}`} data-reveal>
          <p class="tag">{i.tag}</p>
          <p class="t">{i.t}</p>
        </div>
      ))}
    </div>
  </section>
  <Curve from="ivory" to="navy" variant="4" />

  <section class="bg-navy" style="padding-bottom:clamp(60px,9vw,120px)">
    <div class="wrap">
      <p class="eyebrow" data-reveal>価値観 / KEYWORDS</p>
      <h2 class="h-xl" style="margin-top:16px" data-reveal>大切にしている価値観</h2>
      <ul class="kw">
        {kw.map((k, n) => <li data-reveal style={`--d:${n * 0.08}s`}>{k}</li>)}
      </ul>
      <div class="cta-band">
        <p class="h-lg" data-reveal>理念を、事業と会社のかたちで。</p>
        <div class="btns" style="margin-top:24px" data-reveal>
          <a class="btn btn-primary" href="/business/">事業内容 <span aria-hidden="true">→</span></a>
          <a class="btn btn-secondary" href="/about/">会社概要</a>
        </div>
      </div>
    </div>
  </section>
  <Curve from="navy" to="ivory" variant="1" />
</Base>
