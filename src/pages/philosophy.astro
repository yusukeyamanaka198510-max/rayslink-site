---
import Base from '../layouts/Base.astro';
import Curve from '../components/Curve.astro';
import { images } from '../data/site';
// MISSION／VISION／VALUE・価値観キーワードは確定コピー。日本語の副題は読みの表記（カタカナ）のみ。
const items = [
  { en: 'Mission', ja: 'ミッション', t: '若者に選択肢を提供し、希望や可能性を届ける。' },
  { en: 'Vision', ja: 'ビジョン', t: '一人ひとりが光を放ち、その光が社会を照らす。' },
  { en: 'Value', ja: 'バリュー', t: 'Be Rays — 自ら輝き、周囲を照らす存在であれ。' },
];
// Message（会社の思い）：確定コピー（企業理念・MISSION・VISION・価値観・事業の説明）の言葉のみで構成した下書き。新しい事実は含めない。
const message = [
  '笑いながら、全力で。私たちRays linkは、「一笑懸命」を企業理念に、金融教育・宿泊・IT・デジタルなどの様々な事業を展開しています。',
  '人生に希望と可能性を。若者に選択肢を提供し、一人ひとりが光を放ち、その光が社会を照らす。そんな未来をめざして、遊び心と本気で、希望を信じて走り続けます。',
];
---
<Base title="企業理念" path="/philosophy/" description="株式会社Rays linkの企業理念「一笑懸命。」と、MISSION・VISION・VALUE、私たちの思い（メッセージ）をご紹介します。">
  <section class="phero phero-photo-top bg-navy">
    <div class="phero-bg"><img src={images.philosophy} alt="青空を見上げて笑顔を浮かべる若い男女" width="1400" height="643" fetchpriority="high" decoding="async" /></div>
    <div class="wrap">
      <div class="phero-copy">
        <p class="eyebrow" data-reveal>企業理念 / PHILOSOPHY</p>
        <h1 class="mega" style="margin-top:18px"><span class="line-in" style="white-space:nowrap"><span>一笑懸命</span></span></h1>
        <p class="lead" style="margin-top:26px;max-width:30em" data-reveal>笑いながら、全力で。私たちは「一笑懸命」を企業理念に、若者の未来に光を届けます。</p>
      </div>
    </div>
  </section>

  <section class="biz biz--bleed biz--light bg-beige">
    <div class="wrap">
      <div class="seg-list">
        {items.map((i) => (
          <div class="seg seg-static" data-reveal>
            <div class="seg-head"><span class="dot" aria-hidden="true"></span><span class="seg-title"><span class="seg-en">{i.en}</span><span class="seg-ja">{i.ja}</span></span></div>
            <div class="seg-body"><p class="mvv-sentence">{i.t}</p></div>
          </div>
        ))}
        <div class="seg seg-static" data-reveal>
          <div class="seg-head"><span class="dot" aria-hidden="true"></span><span class="seg-title"><span class="seg-en">Message</span><span class="seg-ja">私たちの思い</span></span></div>
          <div class="seg-body">{message.map((m) => <p class="msg">{m}</p>)}</div>
        </div>
      </div>
      <div class="btns" style="margin-top:55px" data-reveal>
        <a class="btn btn-primary" href="/#business">事業内容を見る <span aria-hidden="true">→</span></a>
        <a class="btn btn-text" href="/about/">会社概要へ →</a>
      </div>
    </div>
  </section>
  <Curve from="beige" to="ivory" variant="1" />
</Base>
