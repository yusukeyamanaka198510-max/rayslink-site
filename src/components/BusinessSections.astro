---
// 事業内容の本体（4領域の写真・事業の説明・提携事業）。TOPと事業内容ページの両方から使う。
import Curve from './Curve.astro';
import { domains, partners } from '../data/business';
// intro=true：TOP用。最初の領域（教育）のセクション上部に、見出しと説明文を結合して表示する
const { intro = false } = Astro.props;
---
  {domains.map((d, i) => (
    <section class={`bsec ${i % 2 === 0 ? 'flip' : ''} ${i % 2 ? 'bg-ivory' : 'bg-beige'}`} id={d.id}>
      {intro && i === 0 && (
        <div class="wrap">
          <div class="biz-intro" data-reveal>
            <span id="business" class="anchor"></span>
            <p class="eyebrow">事業内容 / BUSINESS</p>
            <h2 class="h-xl" style="margin-top:20px">事業内容</h2>
            <p class="lead" style="margin-top:21px;max-width:30em">教育、宿泊、サステナビリティ、IT・デジタルの4領域で展開する自社事業と、提携先とともに取り組む提携事業をご紹介します。</p>
          </div>
        </div>
      )}
      <div class="bphoto" data-reveal>
        <img src={d.photo} alt={d.photoPlaceholder ? `${d.en}のイメージ（仮画像）` : `${d.ja}のイメージ画像`} loading="lazy" decoding="async" width="900" height={d.id === "technology" ? 1350 : 1200} />
        {d.photoPlaceholder && <span class="tag">仮画像</span>}
      </div>
      <div class="wrap">
        <div class="btext">
          <p class="eyebrow" data-reveal>{d.ja}</p>
          <h2 class="en" data-reveal>{d.en}</h2>
          <p class="lead" style="margin-top:8px" data-reveal>{d.lead}</p>
          <div class="svc-list">
            {d.services.map((s) => (
              <article class="svc" data-reveal>
                <p class="k">{s.kind}{s.since ? `｜${s.since}` : ''}</p>
                <h3>{s.name}</h3>
                <p>{s.desc}</p>
                {s.url && <p class="ext"><a class="btn btn-text" href={s.url} target="_blank" rel="noopener noreferrer">公式サイトを見る <span aria-hidden="true">↗</span><span class="sr-only">（外部サイトが新しいタブで開きます）</span></a></p>}
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>
  ))}
  <Curve from="beige" to="navy" variant="2" />

  <section class="bg-navy" id="partnership" style="padding-bottom:clamp(60px,9vw,120px)">
    <div class="wrap">
      <span class="badge" data-reveal>PARTNERSHIP BUSINESS</span>
      <h2 class="h-xl" style="margin-top:20px" data-reveal>提携事業</h2>
      <p class="lead" style="margin-top:12px" data-reveal>以下はRays link単独の事業ではなく、提携・協業先とともに取り組む事業です。</p>
      <div class="pgrid">
        {partners.map((p) => (
          <article class="matte svc" data-reveal>
            <p class="k">{p.kind}</p>
            <h3>{p.name}</h3>
            <p>{p.desc}</p>
            {p.url && <p class="ext"><a class="btn btn-text" href={p.url} target="_blank" rel="noopener noreferrer">公式サイトを見る <span aria-hidden="true">↗</span><span class="sr-only">（外部サイトが新しいタブで開きます）</span></a></p>}
          </article>
        ))}
      </div>
      <div class="btns" style="margin-top:44px"><a class="btn btn-primary" href="/contact/">事業・提携のご相談 <span aria-hidden="true">→</span></a><a class="btn btn-text" href="/about/">会社概要へ →</a></div>
    </div>
  </section>
