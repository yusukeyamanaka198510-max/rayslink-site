---
import { nav, logos } from '../data/site';
const path = Astro.url.pathname;
const cur = (h: string) => (h === '/' ? path === '/' : path.startsWith(h));
---
<header class="header" id="header">
  <a class="logo" href="/" aria-label="株式会社Rays link TOPへ"><img src={logos.horizontal} alt="Rays link" width="140" height="30" /></a>
  <nav aria-label="メイン">
    <ul>
      {nav.map((n) => <li><a href={n.href} aria-current={cur(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
      <li><a class="cta" href="/contact/" aria-current={cur('/contact/') ? 'page' : undefined}>CONTACT</a></li>
    </ul>
  </nav>
  <button class="burger" id="burger" aria-expanded="false" aria-controls="mmenu" aria-label="メニューを開く"><span></span><span></span><span></span></button>
</header>
<div class="mmenu" id="mmenu" aria-hidden="true">
  <div class="glass">
    {nav.map((n) => <a href={n.href}>{n.label}<span aria-hidden="true">→</span></a>)}
    <a class="cta" href="/contact/">CONTACT</a>
  </div>
</div>
